## .gitignore

# Virtual environments
.venv/
venv/
env/

# Environment variables and secrets
.env
.env.*
!.env.example

# Python cache
__pycache__/
*.py[cod]
*.pyo

# Testing and linting
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/

# Python packaging
*.egg-info/
build/
dist/

# Generated ML artifacts
artifacts/*
!artifacts/.gitkeep

# IDE
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db
